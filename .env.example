# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database (also holds the job queue — no Redis needed)
DATABASE_URL=mysql://root:mysql@localhost:3308/campaigncue

# Background jobs run inside the web app by default. Set to false when the
# worker runs as its own process (npm run worker) or on serverless hosts.
# RUN_JOBS=true

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=CampaignCue <login@example.com>

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40). Port 465 with smtps:// is
# implicit TLS; port 587 with smtp:// is STARTTLS.
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# Razorpay (optional) — INR subscriptions with UPI Autopay and cards.
# Leave unset to offer Stripe only. Plan IDs come from monthly INR plans
# created in the Razorpay dashboard.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_PLAN_PRO=plan_...
RAZORPAY_PLAN_AGENCY=plan_...

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
